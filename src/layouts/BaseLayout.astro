---
import {
  absoluteUrl,
  assetUrl,
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  FAVICON_IMAGE,
  ICON_IMAGE,
  SITE_NAME,
  THEME_COLOR,
} from '../data/seo';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonicalPath,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalUrl = absoluteUrl(canonicalPath ?? Astro.url.pathname, Astro.site, base);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(assetUrl(ogImage, base), Astro.site, base);
const iconUrl = assetUrl(FAVICON_IMAGE, base);
const appleTouchIconUrl = assetUrl(ICON_IMAGE, base);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={iconUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} />
    <meta name="theme-color" content={THEME_COLOR} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@500;600;700&display=swap"
    />

    <slot name="head" />
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
