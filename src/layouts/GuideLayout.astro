---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { buildArticleSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  canonicalPath: string;
  schemaPath: string;
}

const { title, description, publishDate, updatedDate, canonicalPath, schemaPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const formattedPublishDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formattedUpdatedDate = (updatedDate ?? publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const articleSchema = buildArticleSchema({
  title,
  description,
  path: schemaPath,
  publishDate,
  updatedDate,
});
---

<BaseLayout title={`${title} | BettorIndex`} description={description} canonicalPath={canonicalPath} ogType="article">
  <JsonLd slot="head" data={articleSchema} />
  <SiteHeader slot="header" />

  <div class="guide-page">
    <div class="container container--narrow prose">
      <nav class="guide-breadcrumb" aria-label="Breadcrumb">
        <a href={base}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}guides/`}>Guides</a>
        <span aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>

      <header class="guide-header">
        <p class="section-label">Research Guide</p>
        <h1>{title}</h1>
        <p class="guide-meta">
          Published {formattedPublishDate}
          {updatedDate && updatedDate.getTime() !== publishDate.getTime() && (
            <> · Updated {formattedUpdatedDate}</>
          )}
        </p>
      </header>

      <article class="card guide-content">
        <slot />
      </article>

      <div class="guide-links">
        <p>
          Explore card sections on the homepage:
          <a href={`${base}#prop-markets`}>Player Props</a> ·
          <a href={`${base}#game-lines`}>Game Lines</a> ·
          <a href={`${base}#faq`}>FAQ</a>
        </p>
      </div>
    </div>
  </div>

  <Disclaimer />
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .guide-page {
    padding: 40px 0 24px;
  }

  .guide-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 14px;
    color: var(--muted);
  }

  .guide-breadcrumb a {
    color: var(--accent-bright);
    text-decoration: none;
    font-weight: 600;
  }

  .guide-breadcrumb a:hover {
    text-decoration: underline;
  }

  .guide-header {
    margin-bottom: 24px;
  }

  .guide-header h1 {
    margin: 8px 0 12px;
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .guide-meta {
    margin: 0;
    color: var(--muted-soft);
    font-size: 14px;
  }

  .guide-content {
    padding: 28px 32px;
  }

  .guide-content :global(h2) {
    margin-top: 32px;
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--accent-bright);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .guide-content :global(h2:first-child) {
    margin-top: 0;
  }

  .guide-content :global(p),
  .guide-content :global(li) {
    color: var(--muted);
    line-height: 1.7;
    font-size: 16px;
  }

  .guide-content :global(ul) {
    padding-left: 20px;
  }

  .guide-content :global(a) {
    color: var(--accent-bright);
    font-weight: 600;
  }

  .guide-links {
    margin-top: 24px;
    color: var(--muted);
    font-size: 15px;
  }

  .guide-links a {
    color: var(--accent-bright);
    font-weight: 600;
    text-decoration: none;
  }

  .guide-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .guide-content {
      padding: 22px 20px;
    }
  }
</style>
