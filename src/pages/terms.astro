---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Terms of Use — BettorIndex"
  description="BettorIndex Terms of Use and AI Chat Disclosures."
>
  <SiteHeader slot="header" />

  <div class="legal-page">
    <div class="container container--narrow prose">
      <h1>Terms of Use</h1>
      <p class="page-subtitle">Terms of Use and AI Chat Disclosures for BettorIndex.</p>

      <section class="card" style="margin-bottom: 24px;">
        <h2>AI Chat Disclaimer</h2>
        <p>
          You are interacting with an AI language model. Responses are generated and may not always be accurate,
          complete, or appropriate. Do not rely on AI responses for medical, legal, or financial advice.
          Please report any inappropriate content.
        </p>

        <h2 style="margin-top: 28px;">AI Chat Privacy</h2>
        <p>
          Your chat messages may be sent to our servers for processing and improvement of the AI experience.
          For details, see our <a href={`${base}privacy/`}>Privacy Policy</a>.
        </p>
      </section>

      <section class="card">
        <h2>Terms of Use</h2>
        <p class="effective-date">Effective Date: March 28th, 2026</p>

        <h3>1. Acceptance</h3>
        <p>
          By using the App, you agree to these Terms of Use.
        </p>

        <h3>2. No Betting or Gambling</h3>
        <p>
          This App provides analytics and information for entertainment and informational purposes only. We do not provide
          betting services or encourage gambling. Users are solely responsible for any decisions made based on the
          information provided.
        </p>

        <h3>3. AI Chat Disclaimer</h3>
        <p>
          You are interacting with an AI language model. Responses are generated and may not always be accurate, complete,
          or appropriate. Do not rely on AI responses for medical, legal, or financial advice. Please report any
          inappropriate content.
        </p>

        <h3>4. Third-Party Data</h3>
        <p>
          The App uses data from third-party APIs. We are not responsible for the accuracy, completeness, or availability
          of this data. Features may be unavailable or inaccurate if third-party services are interrupted.
        </p>

        <h3>5. Limitation of Liability</h3>
        <p>
          Use of the App is at your own risk. We are not liable for any damages or losses resulting from use of the App
          or reliance on its content.
        </p>

        <h3>6. Changes to Terms</h3>
        <p>
          We may update these Terms of Use at any time. Continued use of the App constitutes acceptance of the new terms.
        </p>

        <h3>7. Contact</h3>
        <p>
          For questions about these Terms, contact us at: <strong>eddie4k1080@gmail.com</strong>
        </p>

        <p style="margin-top: 28px;">
          See also our <a href={`${base}privacy/`}>Privacy Policy</a>.
        </p>
      </section>
    </div>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .legal-page {
    padding: 48px 0 80px;
  }
</style>
