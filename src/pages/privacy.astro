---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Privacy Policy — BettorIndex"
  description="BettorIndex privacy policy — how we collect, use, and protect your information when you use the sports betting research app."
  canonicalPath="/privacy/"
>
  <SiteHeader slot="header" />

  <div class="legal-page">
    <div class="container container--narrow prose">
      <h1>Privacy Policy</h1>
      <p class="page-subtitle">How BettorIndex collects, uses, and protects your information.</p>

      <section class="card">
        <p class="effective-date">Effective Date: March 28th, 2026</p>

        <p>
          This Privacy Policy describes how BettorIndex ("we", "us", or "our") collects, uses, and protects your
          information when you use our mobile application (the "App").
        </p>

        <h2>1. Information We Collect</h2>
        <ul>
          <li><strong>User-Provided Data:</strong> When you use features such as AI Chat, we collect the messages you send and receive.</li>
          <li><strong>Usage Data:</strong> We may collect information about how you use the App, such as feature usage, device type, and operating system.</li>
        </ul>

        <h2>2. How We Use Your Information</h2>
        <ul>
          <li>To provide and improve App features, including AI Chat and analytics.</li>
          <li>To respond to user inquiries and support requests.</li>
          <li>To monitor and moderate content for safety and compliance.</li>
        </ul>

        <h2>3. Data Sharing</h2>
        <ul>
          <li><strong>Third-Party APIs:</strong> We use third-party APIs to provide sports data and AI chat functionality. Your data may be shared with these services as needed to deliver features.</li>
          <li><strong>No Sale of Data:</strong> We do not sell your personal data to third parties.</li>
        </ul>

        <h2>4. Data Security</h2>
        <p>
          We use reasonable measures to protect your information. However, no method of transmission or storage is 100% secure.
        </p>

        <h2>5. User Rights</h2>
        <ul>
          <li>You may request deletion of your data by contacting us at <strong>eddie4k1080@gmail.com</strong>.</li>
          <li>You may report inappropriate content via the in-app reporting feature.</li>
        </ul>

        <h2>6. Children's Privacy</h2>
        <p>
          The App is not intended for children under 17. If you are under 17, please do not use the App.
        </p>

        <h2>7. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. Changes will be posted in the App and/or on our website.
        </p>

        <h2>8. Contact Us</h2>
        <p>
          If you have questions about this policy, contact us at: <strong>eddie4k1080@gmail.com</strong>
        </p>

        <p style="margin-top: 28px;">
          See also our <a href={`${base}terms/`}>Terms of Use</a>.
        </p>
      </section>
    </div>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .legal-page {
    padding: 48px 0 80px;
  }
</style>
