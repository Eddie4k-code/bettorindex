---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { buildGuidesHubSchema } from '../../data/schema';

const base = import.meta.env.BASE_URL;
const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const hubSchema = buildGuidesHubSchema(
  guides.map((guide) => ({
    title: guide.data.title,
    path: `/guides/${guide.slug}/`,
    description: guide.data.description,
  })),
);
---

<BaseLayout
  title="Sports Betting Research Guides | BettorIndex"
  description="Guides for researching NBA, MLB, and NFL player props and game lines with trends, leans, and best odds — decision aid, not picks."
  canonicalPath="/guides/"
>
  <JsonLd slot="head" data={hubSchema} />
  <SiteHeader slot="header" />

  <div class="guides-page">
    <div class="container">
      <p class="section-label">Guides</p>
      <h1 class="section-title">Sports Betting Research Guides</h1>
      <p class="section-subtitle">
        How to research player props and game lines across NBA, MLB, and NFL — aligned with how BettorIndex cards actually work.
      </p>

      <div class="guides-grid">
        {guides.map((guide) => (
          <article class="card guide-card">
            <h2 class="guide-card__title">
              <a href={`${base}guides/${guide.slug}/`}>{guide.data.title}</a>
            </h2>
            <p class="guide-card__desc">{guide.data.description}</p>
            <a href={`${base}guides/${guide.slug}/`} class="guide-card__link">Read guide →</a>
          </article>
        ))}
      </div>

      <p class="guides-footer">
        New to BettorIndex?
        <a href={`${base}#products`}>See what you can research</a> on the homepage or read the
        <a href={`${base}#faq`}>FAQ</a>.
      </p>
    </div>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .guides-page {
    padding: 48px 0 80px;
  }

  .guides-grid {
    display: grid;
    gap: 20px;
    margin-top: 32px;
  }

  .guide-card {
    padding: 24px 28px;
  }

  .guide-card__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .guide-card__title a {
    color: var(--text);
    text-decoration: none;
  }

  .guide-card__title a:hover {
    color: var(--accent-bright);
  }

  .guide-card__desc {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .guide-card__link {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-bright);
    text-decoration: none;
  }

  .guide-card__link:hover {
    text-decoration: underline;
  }

  .guides-footer {
    margin-top: 36px;
    color: var(--muted);
    font-size: 15px;
  }

  .guides-footer a {
    color: var(--accent-bright);
    font-weight: 600;
    text-decoration: none;
  }

  .guides-footer a:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .guides-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
