---
import { APP_STORE_URL, assetUrl, ICON_IMAGE } from '../data/seo';

const iconUrl = assetUrl(ICON_IMAGE, import.meta.env.BASE_URL);
---
<section class="section section--cta">
  <div class="container">
    <div class="cta">
      <div class="cta__glow" aria-hidden="true"></div>
      <img
        src={iconUrl}
        alt="BettorIndex app icon"
        width="64"
        height="64"
        class="cta__icon"
      />
      <h2 class="cta__title">Download BettorIndex</h2>
      <p class="cta__text">
        Your sports betting research tool for NBA, MLB, and NFL. Free to start with optional Premium on iOS.
      </p>
      <div class="cta__actions">
        <a href={APP_STORE_URL} class="btn btn--primary" rel="noopener noreferrer" target="_blank">
          Download on the App Store
        </a>
        <span class="badge badge--muted">Android — Coming Soon</span>
      </div>
    </div>
  </div>
</section>

<style>
  .section--cta {
    padding-bottom: 80px;
  }

  .cta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 48px 24px;
    border-radius: var(--radius-lg);
    background: var(--card);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-card);
  }

  .cta__glow {
    position: absolute;
    inset: auto 20% -40%;
    height: 200px;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.15), transparent 70%);
    pointer-events: none;
  }

  .cta__icon {
    position: relative;
    z-index: 1;
    border-radius: 14px;
    margin-bottom: 16px;
    box-shadow: 0 12px 32px rgba(34, 211, 238, 0.2);
  }

  .cta__title {
    position: relative;
    z-index: 1;
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
  }

  .cta__text {
    position: relative;
    z-index: 1;
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 15px;
    max-width: 420px;
  }

  .cta__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
</style>
