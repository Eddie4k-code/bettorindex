---
---

<div class="preview" aria-hidden="true">
  <div class="preview__glow"></div>
  <div class="preview__card">
    <div class="preview__header">
      <div>
        <p class="preview__player">Josh Allen</p>
        <p class="preview__matchup">BUF @ MIA</p>
        <span class="preview__venue">HOME TONIGHT</span>
      </div>
      <span class="preview__market">PASS YDS</span>
    </div>

    <div class="preview__badges">
      <span class="preview__lean">Strong Lean Over</span>
      <span class="preview__consensus">Same Line Across Books</span>
    </div>

    <div class="preview__read">
      <div class="preview__read-top">
        <span>Market Read</span>
        <strong>Opportunity</strong>
      </div>
      <p>Recent trends support Over and the current price still looks playable.</p>
    </div>

    <div class="preview__stats">
      <div>
        <span>Line</span>
        <strong class="preview__over">OVER 245.5</strong>
        <small>DraftKings</small>
      </div>
      <div>
        <span>Best Odds</span>
        <strong class="preview__over">-108</strong>
        <small>DraftKings</small>
      </div>
    </div>

    <div class="preview__trends">
      <div><span>3G</span><strong>67%</strong></div>
      <div><span>6G</span><strong>60%</strong></div>
      <div><span>10G</span><strong>55%</strong></div>
    </div>
  </div>
</div>

<style>
  .preview {
    position: relative;
    width: min(100%, 420px);
    margin: 0 auto;
  }

  .preview__glow {
    position: absolute;
    inset: 12% 8% -8%;
    background: radial-gradient(circle, rgba(79, 195, 247, 0.22), transparent 68%);
    filter: blur(18px);
    z-index: 0;
  }

  .preview__card {
    position: relative;
    z-index: 1;
    padding: 22px;
    border-radius: 22px;
    background: linear-gradient(180deg, #141c29 0%, #101722 100%);
    border: 1px solid rgba(126, 211, 252, 0.18);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .preview__header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .preview__player {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    color: #f8fafc;
  }

  .preview__matchup {
    margin: 0 0 8px;
    color: #b8c2d6;
    font-size: 14px;
  }

  .preview__venue {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(79, 195, 247, 0.08);
    border: 1px solid rgba(79, 195, 247, 0.18);
    color: #9ed8ff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .preview__market {
    padding: 6px 10px;
    border-radius: 999px;
    background: #1b2331;
    color: #9ed8ff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    height: fit-content;
  }

  .preview__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .preview__lean,
  .preview__consensus {
    padding: 7px 11px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .preview__lean {
    background: rgba(125, 211, 252, 0.14);
    color: #7dd3fc;
    border: 1px solid rgba(125, 211, 252, 0.24);
  }

  .preview__consensus {
    background: rgba(148, 163, 184, 0.08);
    color: #cbd5e1;
    border: 1px solid rgba(148, 163, 184, 0.16);
  }

  .preview__read {
    padding: 14px;
    border-radius: 14px;
    background: #17202d;
    border: 1px solid rgba(148, 163, 184, 0.1);
    margin-bottom: 16px;
  }

  .preview__read-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    color: #93a4bb;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .preview__read-top strong {
    color: #9ed8ff;
  }

  .preview__read p {
    margin: 0;
    color: #cbd5e1;
    font-size: 14px;
    line-height: 1.5;
  }

  .preview__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }

  .preview__stats > div {
    padding: 12px;
    border-radius: 14px;
    background: #101722;
    border: 1px solid rgba(148, 163, 184, 0.08);
  }

  .preview__stats span {
    display: block;
    color: #93a4bb;
    font-size: 12px;
    margin-bottom: 6px;
  }

  .preview__stats strong {
    display: block;
    font-size: 18px;
    margin-bottom: 4px;
  }

  .preview__stats small {
    color: #7f8da3;
    font-size: 12px;
  }

  .preview__over {
    color: #7dd3fc;
  }

  .preview__trends {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .preview__trends > div {
    padding: 10px;
    border-radius: 12px;
    background: #101722;
    border: 1px solid rgba(148, 163, 184, 0.08);
    text-align: center;
  }

  .preview__trends span {
    display: block;
    color: #93a4bb;
    font-size: 11px;
    margin-bottom: 4px;
  }

  .preview__trends strong {
    color: #7dd3fc;
    font-size: 16px;
  }
</style>
