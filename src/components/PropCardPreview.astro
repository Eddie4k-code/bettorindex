---
---

<div class="preview" aria-hidden="true">
  <div class="preview__glow"></div>
  <div class="preview__card">
    <div class="preview__top">
      <div>
        <p class="preview__player">Josh Allen</p>
        <p class="preview__matchup">BUF @ MIA · HOME TONIGHT</p>
      </div>
      <span class="preview__market">PASS YDS</span>
    </div>

    <div class="preview__badges">
      <span class="preview__lean">Lean Over</span>
      <span class="preview__state">Same Line Across Books</span>
    </div>

    <div class="preview__read">
      <span class="preview__read-label">Opportunity</span>
      <p>Trend supports Over and the price looks playable.</p>
    </div>

    <div class="preview__bet">
      <div class="preview__bet-cell">
        <span>Line</span>
        <strong class="over">OVER 245.5</strong>
        <small>DraftKings</small>
      </div>
      <div class="preview__bet-cell">
        <span>Odds</span>
        <strong class="over">-108</strong>
        <small>DraftKings</small>
      </div>
    </div>

    <div class="preview__rates">
      <div><span>3G</span><strong>67%</strong></div>
      <div><span>6G</span><strong>60%</strong></div>
      <div><span>10G</span><strong>55%</strong></div>
    </div>
  </div>
</div>

<style>
  .preview {
    position: relative;
    width: min(100%, 380px);
    margin: 0 auto;
    animation: float 5s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .preview__glow {
    position: absolute;
    inset: 10% 0 -10%;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.25), transparent 65%);
    filter: blur(24px);
    z-index: 0;
  }

  .preview__card {
    position: relative;
    z-index: 1;
    padding: 20px;
    border-radius: 18px;
    background: linear-gradient(165deg, #141c28 0%, #0d1219 100%);
    border: 1px solid rgba(34, 211, 238, 0.2);
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }

  .preview__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .preview__player {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #f8fafc;
  }

  .preview__matchup {
    margin: 0;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preview__market {
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.2);
    color: #67e8f9;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    height: fit-content;
  }

  .preview__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .preview__lean {
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(74, 222, 128, 0.12);
    border: 1px solid rgba(74, 222, 128, 0.3);
    color: #4ade80;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .preview__state {
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(148, 163, 184, 0.08);
    border: 1px solid rgba(148, 163, 184, 0.15);
    color: #cbd5e1;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preview__read {
    padding: 12px 14px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border);
    margin-bottom: 14px;
  }

  .preview__read-label {
    display: block;
    margin-bottom: 4px;
    color: #67e8f9;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .preview__read p {
    margin: 0;
    color: #cbd5e1;
    font-size: 13px;
    line-height: 1.45;
  }

  .preview__bet {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 14px;
  }

  .preview__bet-cell {
    padding: 12px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border);
  }

  .preview__bet-cell span {
    display: block;
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .preview__bet-cell strong {
    display: block;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 2px;
  }

  .preview__bet-cell strong.over {
    color: #4ade80;
  }

  .preview__bet-cell small {
    color: #64748b;
    font-size: 11px;
  }

  .preview__rates {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .preview__rates > div {
    padding: 10px 8px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border);
    text-align: center;
  }

  .preview__rates span {
    display: block;
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
  }

  .preview__rates strong {
    color: #4ade80;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
  }
</style>
