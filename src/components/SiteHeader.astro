---
const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: `${base}#features`, label: 'Features' },
  { href: `${base}#how-it-works`, label: 'How It Works' },
  { href: `${base}#faq`, label: 'FAQ' },
  { href: `${base}privacy/`, label: 'Privacy' },
  { href: `${base}terms/`, label: 'Terms' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={base} class="header__brand">
      <img src={`${base}images/icon.png`} alt="" width="36" height="36" class="header__icon" />
      <span class="header__name">BettorIndex</span>
    </a>
    <nav class="header__nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="header__link">{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(13, 16, 23, 0.78);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
  }

  .header__brand:hover {
    text-decoration: none;
    color: var(--accent-bright);
  }

  .header__icon {
    border-radius: 10px;
    box-shadow: 0 8px 20px rgba(79, 195, 247, 0.18);
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    justify-content: flex-end;
  }

  .header__link {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 0;
    transition: color 0.2s ease;
  }

  .header__link:hover {
    color: var(--accent-bright);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .header__nav {
      gap: 4px 12px;
    }

    .header__link {
      font-size: 13px;
    }
  }
</style>
