---
import { assetUrl, ICON_IMAGE } from '../data/seo';

const base = import.meta.env.BASE_URL;
const iconUrl = assetUrl(ICON_IMAGE, base);
const navLinks = [
  { href: `${base}#products`, label: 'Research' },
  { href: `${base}#prop-markets`, label: 'Player Props' },
  { href: `${base}#game-lines`, label: 'Game Lines' },
  { href: `${base}guides/`, label: 'Guides' },
  { href: `${base}#market-reads`, label: 'Market Read' },
  { href: `${base}#how-it-works`, label: 'How It Works' },
  { href: `${base}#faq`, label: 'FAQ' },
  { href: `${base}about/`, label: 'About' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={base} class="header__brand" aria-label="BettorIndex home">
      <span class="header__brand-mark">
        <img src={iconUrl} alt="" class="header__logo" width="96" height="96" />
      </span>
      <span class="header__brand-name" aria-hidden="true">
        Bettor<span class="header__brand-accent">Index</span>
      </span>
    </a>
    <nav class="header__nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="header__link">{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6, 8, 13, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__brand:hover {
    opacity: 0.92;
    text-decoration: none;
  }

  .header__brand-mark {
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 10px;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(34, 211, 238, 0.18);
  }

  .header__logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.85);
  }

  .header__brand-name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    line-height: 1;
  }

  .header__brand-accent {
    color: var(--accent-bright);
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: flex-end;
  }

  .header__link {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .header__link:hover {
    color: var(--accent-bright);
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .header__nav {
      display: none;
    }

    .header__brand-name {
      font-size: 16px;
    }

    .header__brand-mark {
      width: 36px;
      height: 36px;
    }
  }
</style>
