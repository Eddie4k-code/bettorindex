---
import { assetUrl, NAV_LOGO_IMAGE } from '../data/seo';

const base = import.meta.env.BASE_URL;
const logoUrl = assetUrl(NAV_LOGO_IMAGE, base);
const navLinks = [
  { href: `${base}#products`, label: 'Research' },
  { href: `${base}#prop-markets`, label: 'Player Props' },
  { href: `${base}#game-lines`, label: 'Game Lines' },
  { href: `${base}guides/`, label: 'Guides' },
  { href: `${base}#market-reads`, label: 'Market Read' },
  { href: `${base}#how-it-works`, label: 'How It Works' },
  { href: `${base}#faq`, label: 'FAQ' },
  { href: `${base}about/`, label: 'About' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={base} class="header__brand">
      <img src={logoUrl} alt="BettorIndex" class="header__logo" width="574" height="418" />
    </a>
    <nav class="header__nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="header__link">{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6, 8, 13, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__brand:hover {
    opacity: 0.92;
    text-decoration: none;
  }

  .header__logo {
    display: block;
    height: 56px;
    width: auto;
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: flex-end;
  }

  .header__link {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .header__link:hover {
    color: var(--accent-bright);
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .header__nav {
      display: none;
    }

    .header__logo {
      height: 44px;
    }
  }
</style>
