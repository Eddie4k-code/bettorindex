---
---

<div class="preview" aria-hidden="true">
  <div class="preview__glow"></div>
  <div class="preview__shell">
    <div class="preview__header">
      <span class="preview__header-pill">Tonight's Prop Spotlights</span>
      <span class="preview__sparkle" aria-hidden="true">✦</span>
    </div>

    <div class="preview__count-block">
      <p class="preview__count">12</p>
      <p class="preview__count-label">flagged props tonight</p>
      <div class="preview__sports">
        <span>NBA</span>
        <span>MLB</span>
      </div>
    </div>

    <p class="preview__subtitle">Props flagged with a strong lean and hot recent form</p>
    <p class="preview__positioning">Research-first curation — not picks.</p>

    <div class="preview__card">
      <div class="preview__top">
        <div>
          <p class="preview__player">Anthony Edwards</p>
          <p class="preview__matchup">MIN @ LAL · AWAY TONIGHT</p>
        </div>
        <span class="preview__market">Points</span>
      </div>

      <div class="preview__badges">
        <span class="preview__lean preview__lean--over">Strong Lean Over</span>
        <span class="preview__state">Opportunity</span>
      </div>

      <div class="preview__row-preview">
        <span>O 28.5 pts</span>
        <span class="preview__row-rate">70%</span>
      </div>

      <div class="preview__cta">View Spotlight →</div>
    </div>
  </div>
</div>

<style>
  .preview {
    position: relative;
    width: min(100%, 360px);
    margin: 0 auto;
    animation: float 5s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .preview__glow {
    position: absolute;
    inset: 10% 0 -10%;
    background: radial-gradient(circle, rgba(79, 195, 247, 0.22), transparent 65%);
    filter: blur(24px);
    z-index: 0;
  }

  .preview__shell {
    position: relative;
    z-index: 1;
    padding: 18px;
    border-radius: 20px;
    background: linear-gradient(165deg, #141c28 0%, #0d1219 100%);
    border: 1px solid rgba(79, 195, 247, 0.18);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
  }

  .preview__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .preview__header-pill {
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(79, 195, 247, 0.12);
    border: 1px solid rgba(79, 195, 247, 0.25);
    color: #7dd3fc;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .preview__sparkle {
    color: #4fc3f7;
    font-size: 18px;
  }

  .preview__count-block {
    margin-bottom: 10px;
  }

  .preview__count {
    margin: 0;
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 700;
    color: #f8fafc;
    line-height: 1;
  }

  .preview__count-label {
    margin: 4px 0 10px;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
  }

  .preview__sports {
    display: flex;
    gap: 6px;
  }

  .preview__sports span {
    padding: 4px 10px;
    border-radius: 999px;
    background: #1b2331;
    color: #cbd5e1;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .preview__subtitle {
    margin: 0 0 4px;
    color: #cbd5e1;
    font-size: 13px;
    line-height: 1.45;
  }

  .preview__positioning {
    margin: 0 0 14px;
    color: #7dd3fc;
    font-size: 12px;
    font-weight: 600;
  }

  .preview__card {
    padding: 14px;
    border-radius: 14px;
    background: #101722;
    border: 1px solid rgba(148, 163, 184, 0.1);
  }

  .preview__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .preview__player {
    margin: 0 0 4px;
    font-size: 17px;
    font-weight: 700;
    color: #f8fafc;
  }

  .preview__matchup {
    margin: 0;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preview__market {
    padding: 4px 9px;
    border-radius: 999px;
    background: #1b2331;
    color: #9ed8ff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    height: fit-content;
  }

  .preview__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .preview__lean,
  .preview__state {
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preview__lean--over {
    background: rgba(74, 222, 128, 0.15);
    border: 1px solid rgba(74, 222, 128, 0.3);
    color: #86efac;
  }

  .preview__state {
    background: rgba(79, 195, 247, 0.12);
    border: 1px solid rgba(79, 195, 247, 0.25);
    color: #7dd3fc;
  }

  .preview__row-preview {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    border-radius: 10px;
    background: #0d1219;
    border: 1px solid rgba(148, 163, 184, 0.08);
    font-size: 13px;
    color: #cbd5e1;
    margin-bottom: 10px;
  }

  .preview__row-rate {
    color: #86efac;
    font-weight: 700;
  }

  .preview__cta {
    text-align: center;
    padding: 10px;
    border-radius: 10px;
    background: rgba(79, 195, 247, 0.1);
    border: 1px solid rgba(79, 195, 247, 0.2);
    color: #7dd3fc;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
