---
import TopMoverCardPreview from './TopMoverCardPreview.astro';

const cardSections = [
  {
    title: 'Dedicated Tab',
    description: 'Top Movers lives in its own bottom tab — not buried inside Prop Markets.',
  },
  {
    title: 'Line vs Odds Moves',
    description: 'Switch between Line Moves and Odds Moves to see how markets shifted.',
  },
  {
    title: 'Props & Game Lines',
    description: 'Filter Player Props or Game Lines — same cross-book scanner for both.',
  },
  {
    title: 'Cross-Book Summary',
    description: 'See agreement at a glance — e.g. "2 of 3 sportsbooks moved the line down."',
  },
  {
    title: 'Sportsbook Breakdown',
    description: 'Expand a collapsible 24-hour breakdown per book to see each book\'s all-day move.',
  },
  {
    title: 'Next 3 Hours',
    description: 'Only games starting within the next 3 hours — snapshot-based, refreshed about every 15 minutes.',
  },
];
---

<section class="section section--surface" id="top-movers">
  <div class="container">
    <p class="section-label">Top Movers</p>
    <h2 class="section-title">Biggest line and odds shifts across major sportsbooks</h2>
    <p class="section-subtitle">
      Cross-book movement for player props and game lines — a snapshot-based scanner, not a live odds board.
    </p>

    <div class="layout">
      <div class="grid">
        {cardSections.map((section, i) => (
          <article class="card section-card">
            <span class="section-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="section-card__title">{section.title}</h3>
            <p class="section-card__desc">{section.description}</p>
          </article>
        ))}
      </div>

      <div class="preview-wrap">
        <TopMoverCardPreview />
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  .grid {
    display: grid;
    gap: 14px;
  }

  .section-card__num {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: rgba(251, 191, 36, 0.2);
  }

  .section-card__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .section-card__desc {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .preview-wrap {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 1fr min(360px, 38%);
      gap: 40px;
      align-items: center;
    }
  }
</style>
