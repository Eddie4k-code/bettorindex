---
const books = ['BetMGM', 'DraftKings', 'FanDuel', 'Fanatics'];
---

<section class="section section--surface">
  <div class="container books">
    <p class="section-label">Books We Track</p>
    <h2 class="section-title">BetMGM · DraftKings · FanDuel · Fanatics</h2>
    <p class="section-subtitle">
      We track BetMGM, DraftKings, FanDuel, and Fanatics to surface the best available line and price on each research card.
    </p>

    <div class="books__row">
      {books.map((book) => (
        <div class="books__pill">{book}</div>
      ))}
    </div>
  </div>
</section>

<style>
  .books__row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .books__pill {
    padding: 14px 28px;
    border-radius: 10px;
    background: var(--card);
    border: 1px solid var(--border-strong);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
    box-shadow: var(--shadow-card);
  }
</style>
