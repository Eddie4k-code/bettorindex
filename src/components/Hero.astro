---
import PropCardPreview from './PropCardPreview.astro';
import GameLineCardPreview from './GameLineCardPreview.astro';
import { APP_STORE_URL } from '../data/seo';

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">Sports Betting Research Tool</p>

      <h1 class="hero__title">
        Research the bet
        <span class="hero__title-accent">before you place it</span>
      </h1>

      <p class="hero__subtitle">
        Scan player props and team game lines with trends, leans, and best available odds on one card.
        Not an odds board. A research card.
      </p>

      <div class="hero__actions">
        <a href={APP_STORE_URL} class="btn btn--primary" rel="noopener noreferrer" target="_blank">
          Download on the App Store
        </a>
        <a href={`${base}#products`} class="btn btn--ghost">See what you can research</a>
      </div>

      <div class="hero__meta">
        <span class="badge">Available on iOS</span>
        <span class="badge badge--muted">Android — Coming Soon</span>
        <div class="hero__sports">
          <span class="hero__sport hero__sport--nba">NBA</span>
          <span class="hero__sport hero__sport--mlb">MLB</span>
          <span class="hero__sport hero__sport--nfl">NFL</span>
        </div>
      </div>
    </div>

    <div class="hero__preview">
      <div class="hero__tabs" role="tablist" aria-label="Card preview type">
        <button
          type="button"
          class="hero__tab hero__tab--active"
          role="tab"
          aria-selected="true"
          data-preview-tab="prop"
        >
          Player Prop
        </button>
        <button
          type="button"
          class="hero__tab"
          role="tab"
          aria-selected="false"
          data-preview-tab="game-line"
        >
          Game Line
        </button>
      </div>

      <div class="hero__preview-panel hero__preview-panel--active" data-preview-panel="prop">
        <PropCardPreview />
      </div>
      <div class="hero__preview-panel" data-preview-panel="game-line" hidden>
        <GameLineCardPreview />
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('[data-preview-tab]');
  const panels = document.querySelectorAll('[data-preview-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-preview-tab');

      tabs.forEach((item) => {
        const isActive = item.getAttribute('data-preview-tab') === target;
        item.classList.toggle('hero__tab--active', isActive);
        item.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const isActive = panel.getAttribute('data-preview-panel') === target;
        panel.classList.toggle('hero__preview-panel--active', isActive);
        panel.hidden = !isActive;
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    padding: 64px 0 80px;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 70% 30%, rgba(34, 211, 238, 0.08), transparent 40%),
      radial-gradient(circle at 20% 80%, rgba(74, 222, 128, 0.05), transparent 35%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .hero__eyebrow {
    margin: 0 0 16px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-size: clamp(40px, 7vw, 68px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    max-width: 12ch;
  }

  .hero__title-accent {
    display: block;
    background: linear-gradient(90deg, #67e8f9 0%, #4ade80 50%, #67e8f9 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 4s linear infinite;
  }

  @keyframes shimmer {
    to { background-position: 200% center; }
  }

  .hero__subtitle {
    margin: 0 0 28px;
    max-width: 46ch;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero__sports {
    display: flex;
    gap: 8px;
  }

  .hero__sport {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__sport--nba {
    color: var(--nba);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .hero__sport--mlb {
    color: var(--mlb);
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.25);
  }

  .hero__sport--nfl {
    color: var(--nfl);
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  .hero__preview {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero__tabs {
    display: flex;
    gap: 8px;
    align-self: center;
    padding: 4px;
    border-radius: 12px;
    background: rgba(17, 24, 34, 0.9);
    border: 1px solid var(--border);
  }

  .hero__tab {
    padding: 8px 16px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .hero__tab--active {
    background: var(--accent-dim);
    color: var(--accent-bright);
    border: 1px solid rgba(34, 211, 238, 0.25);
  }

  .hero__preview-panel {
    display: none;
  }

  .hero__preview-panel--active {
    display: block;
  }

  @media (min-width: 900px) {
    .hero {
      padding: 88px 0 96px;
    }

    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .hero__title {
      max-width: none;
    }

    .hero__tabs {
      align-self: flex-start;
    }
  }
</style>
