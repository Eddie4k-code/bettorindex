---
import PropCardPreview from './PropCardPreview.astro';

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <div class="hero__brandline">
        <img src={`${base}images/icon.png`} alt="" width="42" height="42" class="hero__icon" />
        <span>Player Prop Analytics</span>
      </div>

      <h1 class="hero__title">
        Read the prop
        <span>before</span>
        you place it
      </h1>

      <p class="hero__subtitle">
        BettorIndex turns recent trends, tracked book signals, and market disagreement into a clear read on every prop card — so you know whether to play, shop, or wait.
      </p>

      <div class="hero__actions">
        <a href={`${base}#features`} class="btn btn--primary">See how it works</a>
        <a href={`${base}#faq`} class="btn btn--ghost">Read the FAQ</a>
      </div>

      <div class="hero__badges">
        <span class="badge">Coming Soon — iOS</span>
        <span class="badge badge--muted">Android — Later</span>
      </div>

      <div class="hero__sports">
        <span>NBA</span>
        <span>MLB</span>
        <span>NFL</span>
      </div>
    </div>

    <PropCardPreview />
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 88px;
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .hero__brandline {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    color: var(--accent-bright);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__icon {
    border-radius: 12px;
    box-shadow: 0 10px 28px rgba(79, 195, 247, 0.22);
  }

  .hero__title {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-size: clamp(42px, 7vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 11ch;
  }

  .hero__title span {
    display: block;
    background: linear-gradient(135deg, #9ed8ff 0%, #4fc3f7 55%, #34d399 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    margin: 0 0 28px;
    max-width: 54ch;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 22px;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .hero__sports {
    display: inline-flex;
    gap: 10px;
    padding: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
  }

  .hero__sports span {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.02);
  }

  .hero__sports span:nth-child(1) {
    color: #fcd34d;
    background: rgba(245, 158, 11, 0.1);
  }

  .hero__sports span:nth-child(2) {
    color: #fda4af;
    background: rgba(251, 113, 133, 0.1);
  }

  .hero__sports span:nth-child(3) {
    color: #6ee7b7;
    background: rgba(52, 211, 153, 0.1);
  }

  @media (min-width: 960px) {
    .hero {
      padding: 96px 0 104px;
    }

    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }
  }

  @media (max-width: 599px) {
    .hero {
      padding: 56px 0 72px;
    }

    .hero__title {
      max-width: none;
    }
  }
</style>
