---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="container hero__inner">
    <img src={`${base}images/icon.png`} alt="BettorIndex app icon" width="96" height="96" class="hero__icon" />
    <p class="hero__eyebrow">Player Prop Analytics</p>
    <h1 class="hero__title">Compare trends, book disagreement, and prices on player props</h1>
    <p class="hero__subtitle">
      BettorIndex is meant to help you compare recent trends, book disagreement, and available prices.
      It is a decision aid, not a guarantee.
    </p>
    <div class="hero__badges">
      <span class="badge">Coming Soon — iOS</span>
      <span class="badge badge--muted">Android — Later</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 80px 0 64px;
    background: radial-gradient(ellipse at 50% 0%, rgba(79, 195, 247, 0.08) 0%, transparent 60%);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 720px;
  }

  .hero__icon {
    border-radius: 22px;
    margin-bottom: 28px;
    box-shadow: 0 8px 32px rgba(79, 195, 247, 0.2);
  }

  .hero__eyebrow {
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hero__title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 20px;
    color: var(--text);
  }

  .hero__subtitle {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
    margin: 0 0 32px;
    max-width: 580px;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 56px 0 48px;
    }

    .hero__icon {
      width: 72px;
      height: 72px;
    }
  }
</style>
