---
import PropCardPreview from './PropCardPreview.astro';

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">Player Prop Analytics</p>

      <h1 class="hero__title">
        Should you
        <span class="hero__title-accent">bet this prop?</span>
      </h1>

      <p class="hero__subtitle">
        Lean, Market Read, line, odds, hit rates, and injuries — everything on one card.
        Not an odds board. A decision card.
      </p>

      <div class="hero__actions">
        <a href={`${base}#features`} class="btn btn--primary">See what's on a card</a>
      </div>

      <div class="hero__meta">
        <span class="badge">iOS — Coming Soon</span>
        <div class="hero__sports">
          <span class="hero__sport hero__sport--nba">NBA</span>
          <span class="hero__sport hero__sport--mlb">MLB</span>
          <span class="hero__sport hero__sport--nfl">NFL</span>
        </div>
      </div>
    </div>

    <PropCardPreview />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 64px 0 80px;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 70% 30%, rgba(34, 211, 238, 0.08), transparent 40%),
      radial-gradient(circle at 20% 80%, rgba(74, 222, 128, 0.05), transparent 35%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .hero__eyebrow {
    margin: 0 0 16px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-size: clamp(44px, 8vw, 72px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    max-width: 10ch;
  }

  .hero__title-accent {
    display: block;
    background: linear-gradient(90deg, #67e8f9 0%, #4ade80 50%, #67e8f9 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 4s linear infinite;
  }

  @keyframes shimmer {
    to { background-position: 200% center; }
  }

  .hero__subtitle {
    margin: 0 0 28px;
    max-width: 46ch;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
  }

  .hero__actions {
    margin-bottom: 24px;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero__sports {
    display: flex;
    gap: 8px;
  }

  .hero__sport {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__sport--nba {
    color: var(--nba);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .hero__sport--mlb {
    color: var(--mlb);
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.25);
  }

  .hero__sport--nfl {
    color: var(--nfl);
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  @media (min-width: 900px) {
    .hero {
      padding: 88px 0 96px;
    }

    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .hero__title {
      max-width: none;
    }
  }
</style>
