---
const features = [
  {
    title: 'Multi-Book Line Shopping',
    description: 'Compare the best over and under lines and prices across BetMGM, DraftKings, and FanDuel on every prop card.',
    tag: 'BetMGM · DraftKings · FanDuel',
  },
  {
    title: 'Market State Badges',
    description: 'See at a glance whether books agree on the line or are posting different numbers for the same market.',
    tag: 'Same Line · Books Disagree',
  },
  {
    title: 'Trend Hit Rates',
    description: 'Recent over/under hit rates across 10-day, 30-day, and 60-day windows on both NBA and MLB cards.',
    tag: '10D · 30D · 60D',
  },
  {
    title: 'Lean Signals & Market Read',
    description: 'MLB cards surface a trend lean plus a market read — whether to play now, shop the line, shop the price, or wait.',
    tag: 'MLB · OVER · UNDER · Pass',
  },
  {
    title: 'Home/Away Clears',
    description: 'See how often a batter has cleared the line at home vs. away, highlighted for tonight\'s venue.',
    tag: 'MLB',
  },
  {
    title: 'Injury Context',
    description: 'Relevant injury information on MLB prop cards, including status, return dates, and why it matters.',
    tag: 'MLB',
  },
  {
    title: 'NBA & MLB Prop Markets',
    description: 'Browse player points, assists, rebounds, batter hits, and total bases with player search and MLB hit-rate filters.',
    tag: 'NBA · MLB',
  },
];
---

<section class="section section--surface" id="features">
  <div class="container">
    <p class="section-label">Features</p>
    <h2 class="section-title">Everything you need to evaluate a prop</h2>
    <p class="section-subtitle">
      BettorIndex helps you compare recent trends, book disagreement, and available prices — with fuller decision reads on MLB cards.
    </p>

    <div class="grid">
      {features.map((feature) => (
        <div class="card feature">
          <span class="feature__tag">{feature.tag}</span>
          <h3 class="feature__title">{feature.title}</h3>
          <p class="feature__desc">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section--surface {
    background: var(--surface);
  }

  .grid {
    display: grid;
    gap: 20px;
  }

  .feature__tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .feature__title {
    margin: 0 0 10px;
    font-size: 18px;
    color: var(--text);
  }

  .feature__desc {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
