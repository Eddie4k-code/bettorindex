---
const cardSections = [
  {
    title: 'Lean & Book Badge',
    description: 'Strong Lean Over/Under, plus whether tracked books agree on the line or disagree.',
  },
  {
    title: 'Market Read',
    description: 'Opportunity, Worth Watching, or Potential Pass — with a short explanation of why.',
  },
  {
    title: 'Line & Best Odds',
    description: 'One line and one price for your leaned side, with the book it came from.',
  },
  {
    title: 'Hit Rates',
    description: 'Recent over/under percentages for the leaned side. Tap to expand the other side too.',
  },
  {
    title: 'Home / Away Clears',
    description: 'How often the player has cleared this line at home vs. away, with tonight\'s venue highlighted.',
  },
  {
    title: 'Relevant Injuries',
    description: 'Injury notes tied to that player or prop — when we have data for the matchup.',
  },
];
---

<section class="section section--surface" id="features">
  <div class="container">
    <p class="section-label">What's On a Card</p>
    <h2 class="section-title">This is the actual card</h2>
    <p class="section-subtitle">
      Every prop card — NBA, MLB, or NFL — shows the same sections.
    </p>

    <div class="grid">
      {cardSections.map((section, i) => (
        <article class="card section-card">
          <span class="section-card__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="section-card__title">{section.title}</h3>
          <p class="section-card__desc">{section.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 14px;
  }

  .section-card__num {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: rgba(148, 163, 184, 0.2);
  }

  .section-card__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .section-card__desc {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
