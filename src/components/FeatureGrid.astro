---
const features = [
  {
    title: 'Multi-Book Market Context',
    description:
      'See lines and prices from BetMGM, DraftKings, and FanDuel on every card. BettorIndex picks the best line for your leaned side, then the best price at that line — and flags when books agree or disagree.',
    tag: 'BetMGM · DraftKings · FanDuel',
  },
  {
    title: 'Market State Badges',
    description:
      'See at a glance whether books agree on the line or are posting different numbers for the same market.',
    tag: 'Same Line · Books Disagree',
  },
  {
    title: 'Trend Hit Rates',
    description:
      'Weighted over/under hit rates across recent game windows — 10/30/60 days for NBA and MLB, last 3/6/10 games for NFL. Newer results count more.',
    tag: 'Weighted · Per sport',
  },
  {
    title: 'Lean Signals & Market Read',
    description:
      'Every card shows a trend lean (Over/Under), a strength label, and a market read — Opportunity, Worth Watching, or Pass — plus guidance on whether to shop the line or shop the price.',
    tag: 'NBA · MLB · NFL',
  },
  {
    title: 'Home/Away & Venue Context',
    description:
      'See how often a player has cleared the line at home vs. away, with tonight\'s venue highlighted.',
    tag: 'MLB · NFL',
  },
  {
    title: 'Injury Context',
    description:
      'Relevant injury information on MLB prop cards, including status, return dates, and why it matters for the prop.',
    tag: 'MLB',
  },
  {
    title: 'Prop Market Browse',
    description:
      'Browse player props across NBA, MLB, and NFL — points, assists, passing yards, hits, total bases, and more.',
    tag: 'NBA · MLB · NFL',
  },
];
---

<section class="section section--surface" id="features">
  <div class="container">
    <p class="section-label">Features</p>
    <h2 class="section-title">Everything you need to evaluate a prop</h2>
    <p class="section-subtitle">
      BettorIndex helps you compare recent trends, book disagreement, and available prices — with clear decision reads on every prop card.
    </p>

    <div class="grid">
      {features.map((feature) => (
        <div class="card feature">
          <span class="feature__tag">{feature.tag}</span>
          <h3 class="feature__title">{feature.title}</h3>
          <p class="feature__desc">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section--surface {
    background: var(--surface);
  }

  .grid {
    display: grid;
    gap: 20px;
  }

  .feature__tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .feature__title {
    margin: 0 0 10px;
    font-size: 18px;
    color: var(--text);
  }

  .feature__desc {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
