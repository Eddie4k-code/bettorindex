---
const steps = [
  {
    num: '1',
    title: 'Check the lean',
    text: 'Is the trend Over or Under?',
  },
  {
    num: '2',
    title: 'Check the line',
    text: 'One number, one price — that\'s your bet.',
  },
  {
    num: '3',
    title: 'Check the read',
    text: 'Play now, shop for a better number, or pass.',
  },
];
---

<section class="section" id="how-it-works">
  <div class="container">
    <p class="section-label">How It Works</p>
    <h2 class="section-title">30 seconds per card</h2>
    <p class="section-subtitle">Open a prop. Read three things. Decide.</p>

    <div class="steps">
      {steps.map((step) => (
        <div class="step">
          <div class="step__num">{step.num}</div>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 20px;
  }

  .step {
    padding: 28px 24px;
    border-radius: var(--radius-lg);
    background: var(--card);
    border: 1px solid var(--border);
    text-align: center;
  }

  .step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
    border-radius: 12px;
    background: var(--accent-dim);
    border: 1px solid rgba(34, 211, 238, 0.2);
    color: var(--accent-bright);
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
  }

  .step__title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .step__text {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (min-width: 700px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
