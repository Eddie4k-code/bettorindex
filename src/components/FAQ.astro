---
const faqItems = [
  {
    question: 'What does Opportunity mean?',
    answer:
      'The trend and current price both look good enough to bet. This is the strongest read on the card.',
  },
  {
    question: 'What does Worth Watching mean?',
    answer:
      'There\'s a lean, but the spot isn\'t ready. Usually because books disagree on the line, the price isn\'t good enough yet, or the juice is too heavy. Watch it — don\'t force the bet.',
  },
  {
    question: 'What does Potential Pass mean?',
    answer:
      'No strong lean, or the price doesn\'t support a bet. The card is telling you to probably skip this one.',
  },
  {
    question: 'Is this a line-shopping app?',
    answer:
      'No. Each card shows one line and one price for your leaned side. We check DraftKings, FanDuel, and BetMGM behind the scenes to surface that number.',
  },
  {
    question: 'What are Relevant Injuries?',
    answer:
      'Injury notes tied to the player or matchup for that prop — not a full league injury report. Shown when we have data.',
  },
  {
    question: 'What does Same Line Across Books mean?',
    answer:
      'The books we track are posting the same number. The main difference is the price.',
  },
  {
    question: 'What does Books Disagree mean?',
    answer:
      'Books are posting different numbers. Getting the better line usually matters more than a small price difference.',
  },
  {
    question: 'Which sports are supported?',
    answer:
      'NBA, MLB, and NFL player props — all with the same card layout: lean, market read, line, odds, hit rates, home/away clears, and relevant injuries.',
  },
];
---

<section class="section" id="faq">
  <div class="container">
    <p class="section-label">FAQ</p>
    <h2 class="section-title">Quick answers</h2>

    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary class="faq-item__q">{item.question}</summary>
          <p class="faq-item__a">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: 10px;
    max-width: 720px;
  }

  .faq-item {
    border-radius: var(--radius-md);
    background: var(--card);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .faq-item[open] {
    border-color: rgba(34, 211, 238, 0.2);
  }

  .faq-item__q {
    padding: 18px 20px;
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__q::after {
    content: '+';
    color: var(--accent);
    font-size: 20px;
    font-weight: 400;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-item__q::after {
    content: '−';
  }

  .faq-item__a {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }
</style>
