---
const faqItems = [
  {
    question: 'Is this a line-shopping app?',
    answer:
      'No. You don\'t scroll through every book on every prop. Each card shows one line and one price for the leaned side — the bet to evaluate. We check DraftKings, FanDuel, and BetMGM behind the scenes to pick that number.',
  },
  {
    question: 'What is a lean?',
    answer:
      'A lean is which side recent trends favor — Over or Under. It\'s a read, not a lock.',
  },
  {
    question: 'What does "Same Line Across Books" mean?',
    answer:
      'The books we track are posting the same number. Focus on getting the best price.',
  },
  {
    question: 'What does "Books Disagree" mean?',
    answer:
      'Books are posting different numbers. Getting the better line matters more than a small price difference.',
  },
  {
    question: 'What\'s the difference between shop the line and shop the price?',
    answer:
      'Shop the line = books have different numbers, go find the better one. Shop the price = same number everywhere, go find better odds.',
  },
  {
    question: 'Why lean one way but still say pass?',
    answer:
      'A lean tells you the trend direction. The price might still not be good enough to bet.',
  },
  {
    question: 'Which sports are supported?',
    answer:
      'NBA, MLB, and NFL player props. MLB and NFL cards also show home/away splits and relevant injuries when available.',
  },
];
---

<section class="section" id="faq">
  <div class="container">
    <p class="section-label">FAQ</p>
    <h2 class="section-title">Quick answers</h2>

    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary class="faq-item__q">{item.question}</summary>
          <p class="faq-item__a">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: 10px;
    max-width: 720px;
  }

  .faq-item {
    border-radius: var(--radius-md);
    background: var(--card);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .faq-item[open] {
    border-color: rgba(34, 211, 238, 0.2);
  }

  .faq-item__q {
    padding: 18px 20px;
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__q::after {
    content: '+';
    color: var(--accent);
    font-size: 20px;
    font-weight: 400;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-item__q::after {
    content: '−';
  }

  .faq-item__a {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }
</style>
