---
import { propFaq, gameLineFaq, sharedFaq } from '../data/faq';
---

<section class="section" id="faq">
  <div class="container">
    <p class="section-label">FAQ</p>
    <h2 class="section-title">Sports Betting Research FAQ</h2>

    <div class="faq-sections">
      <div class="faq-section">
        <h3 class="faq-section__title">Prop Markets</h3>
        <div class="faq-list">
          {propFaq.map((item) => (
            <details class="faq-item">
              <summary class="faq-item__q">{item.question}</summary>
              <p class="faq-item__a">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="faq-section">
        <h3 class="faq-section__title">Game Lines</h3>
        <div class="faq-list">
          {gameLineFaq.map((item) => (
            <details class="faq-item">
              <summary class="faq-item__q">{item.question}</summary>
              <p class="faq-item__a">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="faq-section">
        <h3 class="faq-section__title">Shared</h3>
        <div class="faq-list">
          {sharedFaq.map((item) => (
            <details class="faq-item">
              <summary class="faq-item__q">{item.question}</summary>
              <p class="faq-item__a">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-sections {
    display: grid;
    gap: 32px;
  }

  .faq-section__title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-bright);
  }

  .faq-list {
    display: grid;
    gap: 10px;
    max-width: 720px;
  }

  .faq-item {
    border-radius: var(--radius-md);
    background: var(--card);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .faq-item[open] {
    border-color: rgba(34, 211, 238, 0.2);
  }

  .faq-item__q {
    padding: 18px 20px;
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__q::after {
    content: '+';
    color: var(--accent);
    font-size: 20px;
    font-weight: 400;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-item__q::after {
    content: '−';
  }

  .faq-item__a {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }
</style>
