---
import { assetUrl, NAV_LOGO_IMAGE } from '../data/seo';

const base = import.meta.env.BASE_URL;
const logoUrl = assetUrl(NAV_LOGO_IMAGE, base);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <img src={logoUrl} alt="BettorIndex" class="footer__logo" />
        <p class="footer__tagline">Sports betting research for NBA, MLB, and NFL — player props and game lines.</p>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <a href={`${base}#products`}>Research</a>
        <a href={`${base}#prop-markets`}>Player Props</a>
        <a href={`${base}#game-lines`}>Game Lines</a>
        <a href={`${base}guides/`}>Guides</a>
        <a href={`${base}#market-reads`}>Market Read</a>
        <a href={`${base}#how-it-works`}>How It Works</a>
        <a href={`${base}#faq`}>FAQ</a>
        <a href={`${base}about/`}>About</a>
        <a href={`${base}privacy/`}>Privacy Policy</a>
        <a href={`${base}terms/`}>Terms of Use</a>
        <a href={`${base}accessibility/`}>Accessibility</a>
        <a href="mailto:eddie4k1080@gmail.com">Contact</a>
      </nav>
    </div>

    <p class="footer__copy">&copy; {year} Edward O'Connor. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(23, 29, 40, 0.45), rgba(13, 16, 23, 0.9));
    padding: 48px 0 40px;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 360px;
  }

  .footer__logo {
    width: 180px;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .footer__tagline {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }

  .footer__nav a {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }

  .footer__nav a:hover {
    color: var(--accent-bright);
    text-decoration: none;
  }

  .footer__copy {
    margin: 0;
    font-size: 13px;
    color: var(--muted-soft);
  }

  @media (min-width: 800px) {
    .footer__top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }
</style>
