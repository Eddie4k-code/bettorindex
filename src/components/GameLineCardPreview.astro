---
---

<div class="preview preview--game-line" aria-hidden="true">
  <div class="preview__glow"></div>
  <div class="preview__card">
    <div class="preview__top">
      <div>
        <p class="preview__matchup-title">Boston Celtics @ Los Angeles Lakers</p>
        <p class="preview__time">Tonight · 7:30 PM ET</p>
      </div>
      <span class="preview__market">Spread</span>
    </div>

    <div class="preview__lean-row">
      <span class="preview__lean">Trend Favors Boston Celtics</span>
    </div>

    <div class="preview__trends">
      <p>Covered 6 of last 10 away games</p>
      <p>Covered 4 of last 6 against Los Angeles Lakers</p>
    </div>

    <div class="preview__bet">
      <div class="preview__bet-cell">
        <span>Best Spread</span>
        <strong class="accent">+3.5</strong>
        <small>-110 · draftkings</small>
      </div>
    </div>

    <div class="preview__split">
      <span class="preview__split-label">Split Market</span>
      <span class="preview__split-meta">+3.5 draftkings ↔ +4.5 fanduel</span>
    </div>

    <div class="preview__rows">
      <div class="preview__row">
        <span>Relevant Injuries</span>
        <span class="preview__row-meta">2 notes · both teams</span>
      </div>
      <div class="preview__row">
        <span>Los Angeles Lakers Spread</span>
        <span class="preview__row-meta">Show opposing side</span>
      </div>
    </div>
  </div>
</div>

<style>
  .preview--game-line {
    position: relative;
    width: min(100%, 360px);
    margin: 0 auto;
    animation: float 5s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .preview--game-line .preview__glow {
    position: absolute;
    inset: 10% 0 -10%;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.2), transparent 65%);
    filter: blur(24px);
    z-index: 0;
  }

  .preview--game-line .preview__card {
    position: relative;
    z-index: 1;
    padding: 18px;
    border-radius: 20px;
    background: linear-gradient(165deg, #141c28 0%, #0d1219 100%);
    border: 1px solid rgba(148, 163, 184, 0.12);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
  }

  .preview--game-line .preview__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .preview--game-line .preview__matchup-title {
    margin: 0 0 4px;
    font-size: 17px;
    font-weight: 700;
    color: #f8fafc;
    line-height: 1.2;
  }

  .preview--game-line .preview__time {
    margin: 0;
    color: #22d3ee;
    font-size: 11px;
    font-weight: 600;
  }

  .preview--game-line .preview__market {
    padding: 5px 10px;
    border-radius: 7px;
    background: #23242b;
    color: #4FC3F7;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    height: fit-content;
  }

  .preview--game-line .preview__lean-row {
    margin-bottom: 10px;
  }

  .preview--game-line .preview__lean {
    color: #4FC3F7;
    font-size: 15px;
    font-weight: 800;
  }

  .preview--game-line .preview__trends {
    display: grid;
    gap: 4px;
    margin-bottom: 12px;
  }

  .preview--game-line .preview__trends p {
    margin: 0;
    color: #e2e8f0;
    font-size: 12px;
    line-height: 1.4;
  }

  .preview--game-line .preview__bet {
    margin-bottom: 10px;
  }

  .preview--game-line .preview__bet-cell {
    padding: 12px;
    border-radius: 12px;
    background: #101722;
    border: 1px solid rgba(148, 163, 184, 0.08);
  }

  .preview--game-line .preview__bet-cell span {
    display: block;
    color: #93a4bb;
    font-size: 11px;
    margin-bottom: 4px;
  }

  .preview--game-line .preview__bet-cell strong {
    display: block;
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 2px;
  }

  .preview--game-line .preview__bet-cell strong.accent {
    color: #4FC3F7;
  }

  .preview--game-line .preview__bet-cell small {
    color: #7f8da3;
    font-size: 11px;
    text-transform: lowercase;
  }

  .preview--game-line .preview__split {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: #101722;
    border: 1px solid rgba(251, 191, 36, 0.2);
    margin-bottom: 10px;
    font-size: 11px;
  }

  .preview--game-line .preview__split-label {
    color: #fcd34d;
    font-weight: 700;
  }

  .preview--game-line .preview__split-meta {
    color: #93a4bb;
    text-align: right;
  }

  .preview--game-line .preview__rows {
    display: grid;
    gap: 8px;
  }

  .preview--game-line .preview__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: #101722;
    border: 1px solid rgba(148, 163, 184, 0.08);
    font-size: 12px;
    color: #cbd5e1;
  }

  .preview--game-line .preview__row-meta {
    color: #93a4bb;
    font-size: 11px;
    text-align: right;
  }
</style>
