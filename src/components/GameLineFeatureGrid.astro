---
const cardSections = [
  {
    title: 'Team or Direction Lean',
    description: 'Moneyline and spread: team name. Totals: Over or Under — or No Clear Lean.',
  },
  {
    title: 'Records That Drive Lean',
    description: 'Venue and head-to-head windows in plain language. Last-N overall is context only.',
  },
  {
    title: 'Head-to-Head Context',
    description: 'Matchup-specific history against tonight\'s opponent when sample is 3+ games.',
  },
  {
    title: 'Best Line & Odds',
    description: 'Moneyline price, spread line, or total line plus juice from the best available book.',
  },
  {
    title: 'Opposing Side',
    description: 'Expand the other team (h2h/spread) or the other direction (totals) for full context.',
  },
  {
    title: 'Split Market',
    description: 'H2H: price range per team. Spreads/totals: line and price ranges when books disagree.',
  },
  {
    title: 'Relevant Injuries',
    description: 'Injury notes for both teams in the matchup — when we have data, not a full league report.',
  },
];
---

<section class="section section--surface" id="game-lines">
  <div class="container">
    <p class="section-label">Game Line Research</p>
    <h2 class="section-title">What's on a game line card</h2>
    <p class="section-subtitle">
      Research moneyline, spread, and total matchups with the same card structure across NBA, MLB, and NFL.
    </p>

    <div class="grid">
      {cardSections.map((section, i) => (
        <article class="card section-card">
          <span class="section-card__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="section-card__title">{section.title}</h3>
          <p class="section-card__desc">{section.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 14px;
  }

  .section-card__num {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: rgba(148, 163, 184, 0.2);
  }

  .section-card__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .section-card__desc {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
